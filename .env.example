# E-Paper Display Settings
# Note: Display dimensions (800x480) are fixed by Waveshare 7.5" B/V2 hardware
DISPLAY_FULL_REFRESH_INTERVAL=15

# Weather Service Settings
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_LATITUDE=23.426022
WEATHER_LONGITUDE=87.550644
WEATHER_UNITS=metric

# Timezone Settings (IST by default)
TIMEZONE_NAME=IST
TIMEZONE_UTC_OFFSET_HOURS=5
TIMEZONE_UTC_OFFSET_MINUTES=30
